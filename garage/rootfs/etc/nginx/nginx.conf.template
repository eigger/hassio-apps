worker_processes auto;
error_log /dev/stderr warn;
pid /run/nginx/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /dev/stdout combined;
  sendfile on;
  keepalive_timeout 65;
  client_max_body_size 50m;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
  }

  # The web app answers at its base path with no trailing slash: asking for "<base>/"
  # earns a 308 to "<base>", and under Ingress that redirect leaves Home Assistant's
  # ingress route and 404s. So the root request maps to nothing and the prefix alone
  # is proxied; every other path is appended as-is.
  map $uri $web_path {
    %%WEB_ROOT_MAP%%default $uri;
  }

  # Same routing as upstream Caddyfile: /api + /health → API, else → Web.
  #
  # Two front doors reach this server: Home Assistant Ingress, which strips its
  # /api/hassio_ingress/<token> prefix before forwarding, and the published host port,
  # where the browser asks for exactly the prefixed URLs the page was built with. The
  # rewrite below folds both into one shape, and the web upstream gets the prefix put
  # back on because the app only answers under its base path.
  #
  # The prefix is filled in at start-up (rootfs/etc/cont-init.d/10-setup.sh) — the token
  # is assigned per installation, so it cannot be baked into the image.
  server {
    listen 3080 default_server;
    listen [::]:3080 default_server;
    server_name _;

    %%STRIP_INGRESS_PREFIX%%

    location /api/ {
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_pass http://127.0.0.1:8080;
    }

    location = /health {
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_pass http://127.0.0.1:8080;
    }

    location / {
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_pass http://127.0.0.1:3000%%INGRESS_PATH%%$web_path$is_args$args;
    }
  }
}
