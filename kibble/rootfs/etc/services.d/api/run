#!/command/with-contenv bashio
set -euo pipefail

# Export everything the setup step wrote — the API reads UPLOAD_DIR and the cookie flag
# straight from the environment.
set -a
# shellcheck disable=SC1091
source /data/secrets/runtime.env
set +a

bashio::log.info "Waiting for PostgreSQL"
for _ in $(seq 1 60); do
  if pg_isready -h 127.0.0.1 -p 5432 -U postgres >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

if ! pg_isready -h 127.0.0.1 -p 5432 -U postgres >/dev/null 2>&1; then
  bashio::log.fatal "PostgreSQL did not become ready"
  exit 1
fi

su-exec postgres psql -v ON_ERROR_STOP=1 <<SQL
DO \$\$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${POSTGRES_USER}') THEN
    CREATE ROLE ${POSTGRES_USER} LOGIN PASSWORD '${POSTGRES_PASSWORD}';
  ELSE
    ALTER ROLE ${POSTGRES_USER} WITH LOGIN PASSWORD '${POSTGRES_PASSWORD}';
  END IF;
END
\$\$;
SELECT 'CREATE DATABASE ${POSTGRES_DB} OWNER ${POSTGRES_USER}'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '${POSTGRES_DB}')\gexec
SQL

mkdir -p "${UPLOAD_DIR}"

cd /opt/app/api
bashio::log.info "Running Prisma migrations"
# Kibble is on Prisma 7, which moved the datasource URL out of schema.prisma and into
# apps/api/prisma.config.ts. The check keeps an older, pre-7 pin working, the same way
# stash and garage do it.
prisma_args=(migrate deploy --schema apps/api/prisma/schema.prisma)
if [[ -f apps/api/prisma.config.ts ]]; then
  prisma_args+=(--config apps/api/prisma.config.ts)
fi
./node_modules/.bin/prisma "${prisma_args[@]}"

# No `prisma db seed`: the seed CLI resolves its script relative to /app and imports
# apps/api/src, which the release image does not carry. The system event types it would
# create are seeded by the API itself on start-up, so this step is redundant anyway.
bashio::log.info "Starting Kibble API"
exec node apps/api/dist/index.js
