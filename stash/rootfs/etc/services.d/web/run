#!/command/with-contenv bashio
set -euo pipefail

set -a
# shellcheck disable=SC1091
source /data/secrets/runtime.env
set +a

export NODE_ENV=production
export PORT=3000
export HOSTNAME=127.0.0.1

bashio::log.info "Waiting for API"
for _ in $(seq 1 90); do
  if curl -sf "http://127.0.0.1:8080/health" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

bashio::log.info "Starting Stash Web${BASE_PATH:+ under ${BASE_PATH}}"
cd /opt/app/web
# Upstream ships the build with a /__BASE_PATH__ placeholder and rewrites it at start-up
# for whatever path the app is served under — here that is the Ingress entry resolved in
# cont-init. It keeps the untouched copy around, so a changed entry re-applies cleanly.
export APP_ROOT=/opt/app/web
exec /opt/app/web-entrypoint.sh node apps/web/server.js
